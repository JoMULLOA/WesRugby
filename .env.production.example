# Node Environment
NODE_ENV=production

# Application Server
HOST=0.0.0.0
PORT=3000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
PASSWORD=changeme_secure_password
DATABASE=wesrugby
DB_SSL=false

# JWT and Security
ACCESS_TOKEN_SECRET=your_very_long_and_secure_secret_key_here_change_this
cookieKey=your_cookie_secret_key_here_change_this
COOKIE_KEY=your_cookie_secret_key_here_change_this

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# AWS S3 Configuration (si usas S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Application URLs (PRODUCCIÓN)
FRONTEND_URL=https://wesrugby.site
BACKEND_URL=https://wesrugby.site

# Raspberry Pi Inventory API
RASPBERRY_PI_URL=http://192.168.1.XXX:5000
RASPBERRY_PI_API_KEY=your_raspberry_api_key_here
