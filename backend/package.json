{
  "name": "proyectowesrugby",
  "version": "1.0.0",
  "description": "Proyecto WesRugby",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "print:sheet": "node src/scripts/printInventorySheet.js",
    "migration:run": "node runMigrations.js",
    "migration:show": "node showMigrations.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm run test && npm run test:integration"
  },
  "author": "José Manríquez Ulloa",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.657.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^2.1.3",
    "cookie-parser": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dateformat": "^5.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "multer-s3": "^3.0.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.4",
    "socket.io": "^4.0.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.9.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "keywords": []
}
